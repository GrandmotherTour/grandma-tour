DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=halmae_tour

PORT=3000
PYTHON_BIN=python3

# ── 관광 데이터 소스 (가이드 포인트 선정) ──────────────────────────
# 데이터 소스 모드: mock | live  (미지정 시 키 유무로 자동 판단)
POI_SOURCE_MODE=mock

# 한국관광공사 TourAPI (국문 관광정보 서비스 / KorService2)
# 발급: https://www.data.go.kr/data/15101578/openapi.do  (활용신청 → 일반 인증키)
TOUR_API_KEY=
TOUR_API_BASE_URL=http://apis.data.go.kr/B551011/KorService2
TOUR_API_TIMEOUT_MS=8000

# 카카오 REST API 키 (로컬 지오코딩 + 모빌리티 길찾기 공용)
# 발급: https://developers.kakao.com → 내 애플리케이션 → REST API 키
# 길찾기는 별도로 [카카오모빌리티 > 길찾기] 제품 활성화가 필요하다.
KAKAO_REST_KEY=
KAKAO_TIMEOUT_MS=6000
KAKAO_NAVI_BASE_URL=https://apis-navi.kakaomobility.com
KAKAO_NAVI_TIMEOUT_MS=6000

# ── 이동시간 폴백 ────────────────────────────────────────────────
# 카카오 호출이 실패하거나 쿼터를 아껴야 할 때 쓰는 근사값.
# 40km/h 는 주왕산→청송군청 실측(13,755m / 1,231초 = 40.2km/h)에서 나왔다.
# 1.5 는 직선거리 대비 실주행 거리 배율인데 **표본이 1건뿐이라 계속 보정해야 한다.**
# selectionPipeline STEP 5 의 detourCheck 가 이 값을 검증할 실측치를 뽑아준다.
TRAVEL_FALLBACK_KMH=40
TRAVEL_DETOUR_FACTOR=1.5

# 데이터랩(방문자 통계 / 인기도)은 제거됐다.
# POI 단위 인기도를 주는 공개 API 가 존재하지 않아 dataLabClient 는 쓰지 않는다.
# (docs/poi-selection-refactor-inventory.md §1)
