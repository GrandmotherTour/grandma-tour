DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=halmae_tour

PORT=3000
PYTHON_BIN=python3

# ── 관광 데이터 소스 (가이드 포인트 선정) ──────────────────────────
# 데이터 소스 모드: mock | live  (미지정 시 키 유무로 자동 판단)
POI_SOURCE_MODE=mock

# 한국관광공사 TourAPI (국문 관광정보 서비스 / KorService2)
# 발급: https://www.data.go.kr/data/15101578/openapi.do  (활용신청 → 일반 인증키)
TOUR_API_KEY=
TOUR_API_BASE_URL=http://apis.data.go.kr/B551011/KorService2
TOUR_API_TIMEOUT_MS=8000

# 카카오맵 로컬 REST API (좌표 보정/지오코딩)
# 발급: https://developers.kakao.com → 내 애플리케이션 → REST API 키
KAKAO_REST_KEY=
KAKAO_TIMEOUT_MS=6000

# 한국관광 데이터랩 (방문자 통계 / 인기도)
# 발급: 데이터셋별로 다름 (data.go.kr 또는 datalab.visitkorea.or.kr)
DATALAB_API_KEY=
DATALAB_BASE_URL=
DATALAB_OPERATION=
DATALAB_TIMEOUT_MS=8000
